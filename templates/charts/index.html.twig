{% extends 'base.html.twig' %}

{% block title %}Charts — NotQuiteHuman{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="/assets/css/dividends.css">
<link rel="stylesheet" href="/assets/css/charts.css">
{% endblock %}

{% block body %}
<div class="charts-container">

    <div class="charts-header">
        <h1>Charts</h1>
    </div>

    <div class="charts-columns">
        <div class="charts-left">
            <section class="portfolio-section card">
                <h2>Portfolio</h2>
                <div class="table-wrap">
                    <table class="portfolio-table" id="charts-portfolio-table">
                        <thead>
                            <tr>
                                <th>Symbol</th>
                                <th>Name</th>
                                <th class="num">Qty</th>
                                <th class="num">Price (p)</th>
                                <th>Ex-div</th>
                                <th>Dividend</th>
                                <th class="num">Received (p)</th>
                            </tr>
                        </thead>
                        <tbody id="charts-portfolio-body">
                            <tr><td class="loading">Loading…</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="upcoming-section card">
                <h2>Upcoming dividends</h2>
                <div class="table-wrap">
                    <table class="portfolio-table" id="charts-upcoming-table">
                        <thead>
                            <tr>
                                <th>Symbol</th>
                                <th>Name</th>
                                <th>Ex-div</th>
                                <th>Dividend</th>
                            </tr>
                        </thead>
                        <tbody id="charts-upcoming-body">
                            <tr><td class="loading">Loading…</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        <div class="charts-right">
            <section id="chart-panel" class="chart-panel card">
                <div class="chart-header">
                    <h2 id="chart-title">Portfolio Growth</h2>
                    <button id="close-chart" class="btn btn-sm" style="display:none">Close</button>
                </div>
                <div id="price-chart"></div>
            </section>
        </div>
    </div>
</div>

<script src="https://unpkg.com/lightweight-charts@4.1.3/dist/lightweight-charts.standalone.production.js"></script>
<script src="/assets/js/charts.js"></script>
{% endblock %}
