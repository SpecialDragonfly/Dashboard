{% extends 'base.html.twig' %}

{% block title %}Blog — NotQuiteHuman{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="/assets/css/blog.css">
{% endblock %}

{% block body %}
<div class="blog-container">
    <div class="blog-header">
        <h1>Blog</h1>
        <a href="/blog/new" class="btn btn-primary auth-only" style="display:none">
            <i data-feather="plus"></i> New Post
        </a>
    </div>

    {% if posts is empty %}
        <p class="empty-state">No posts yet.</p>
    {% else %}
        <div class="post-list">
            {% for post in posts %}
            <article class="post-card">
                <div class="post-card-meta">
                    <time datetime="{{ post.createdAt|date('Y-m-d') }}">
                        {{ post.createdAt|date('d M Y') }}
                    </time>
                    {% if post.tagsArray is not empty %}
                    <div class="post-tags">
                        {% for tag in post.tagsArray %}
                        <span class="tag">{{ tag }}</span>
                        {% endfor %}
                    </div>
                    {% endif %}
                </div>
                <h2><a href="/blog/{{ post.slug }}">{{ post.title }}</a></h2>
                <div class="post-card-actions auth-only" style="display:none">
                    <a href="/blog/{{ post.slug }}/edit" class="btn btn-sm">Edit</a>
                    <button class="btn btn-sm btn-danger" onclick="deletePost('{{ post.slug }}')">Delete</button>
                </div>
            </article>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}

{% block javascripts %}
<script src="/assets/js/blog.js"></script>
{% endblock %}
