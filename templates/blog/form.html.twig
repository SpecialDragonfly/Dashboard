{% extends 'base.html.twig' %}

{% block title %}{{ post ? 'Edit: ' ~ post.title : 'New Post' }} — NotQuiteHuman{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="/assets/css/blog.css">
{% endblock %}

{% block body %}
<div class="blog-container">
    <div class="blog-header">
        <h1>{{ post ? 'Edit Post' : 'New Post' }}</h1>
        <a href="{{ post ? '/blog/' ~ post.slug : '/blog' }}" class="btn btn-sm">Cancel</a>
    </div>

    <form class="post-form" method="POST" action="{{ post ? '/blog/' ~ post.slug ~ '/edit' : '/blog/new' }}">
        <div class="form-group">
            <label for="title">Title</label>
            <input type="text" id="title" name="title" required
                   value="{{ post ? post.title : '' }}">
        </div>

        <div class="form-group">
            <label for="tags">Tags <small>(comma-separated)</small></label>
            <input type="text" id="tags" name="tags"
                   value="{{ post ? post.tags : '' }}"
                   placeholder="php, development, notes">
        </div>

        <div class="form-group">
            <label for="content">Content <small>(Markdown)</small></label>
            <div class="toolbar">
                <button type="button" onclick="mdWrap('**', '**')"><strong>B</strong></button>
                <button type="button" onclick="mdWrap('*', '*')"><em>I</em></button>
                <button type="button" onclick="mdLink()">Link</button>
                <button type="button" onclick="mdWrap('`', '`')">Code</button>
                <button type="button" onclick="mdWrap('\n```\n', '\n```')">Block</button>
            </div>
            <textarea id="content" name="content" rows="20" required>{{ post ? post.content : '' }}</textarea>
        </div>

        <div class="form-group form-group--inline">
            <label>
                <input type="checkbox" name="published" value="1"
                       {{ (post is null or post.published) ? 'checked' : '' }}>
                Published
            </label>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">
                {{ post ? 'Save Changes' : 'Publish' }}
            </button>
        </div>
    </form>
</div>
{% endblock %}

{% block javascripts %}
<script src="/assets/js/blog.js"></script>
{% endblock %}
