<div class="widget">
    <h3 class="widget-title"><i data-feather="edit-3"></i> Blog</h3>
    {% if posts is empty %}
        <p class="widget-empty">No posts yet.</p>
    {% else %}
        <ul class="widget-list widget-list--links">
            {% for post in posts %}
            <li>
                <a href="/blog/{{ post.slug }}">{{ post.title }}</a>
                <span class="widget-meta">{{ post.createdAt|date('d M Y') }}</span>
                {% if user is defined and not post.published %}
                    <span class="badge badge--draft">Draft</span>
                {% endif %}
            </li>
            {% endfor %}
        </ul>
    {% endif %}
</div>
