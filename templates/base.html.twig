<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}NotQuiteHuman{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/assets/css/colors.css">
    <link rel="stylesheet" href="/assets/css/common.css">
    {% block stylesheets %}{% endblock %}
    <script src="https://unpkg.com/feather-icons"></script>
</head>
<body>
    <header class="header no-print">
        <div class="header-left">
            <a href="/" class="logo-link">
                <canvas id="dragonfly" width="80" height="120" class="dragonfly-canvas"></canvas>
                <span class="logo-text">NotQuiteHuman</span>
            </a>
        </div>
        <nav class="header-nav">
            <a href="/blog">Blog</a>
            <a href="/empire">Empire</a>
            <a href="/dividends" class="auth-only" style="display:none">Dividends</a>
            <a href="/charts" class="auth-only" style="display:none">Charts</a>
            <a href="https://backtest.notquitehuman.co.uk" class="auth-only" style="display:none" target="_blank" rel="noopener">Backtest</a>
            <a href="/login" class="guest-only">Login</a>
            <a href="#" class="auth-only logout-btn" style="display:none">Logout</a>
        </nav>
        <div class="header-right">
            <div class="counter-card">
                <span class="counter-label">Days til Christmas</span>
                <span class="counter-value">{{ christmasDays ?? 0 }}</span>
            </div>
            <div class="counter-card auth-only" style="display:none">
                <span class="counter-label">Days employed</span>
                <span class="counter-value">{{ daysEmployed ?? 0 }}</span>
            </div>
        </div>
    </header>

    <main class="main-content">
        {% block body %}{% endblock %}
    </main>

    <script src="/assets/js/dragonfly-points.js"></script>
    <script src="/assets/js/dragonfly.js"></script>
    <script src="/assets/js/auth.js"></script>
    <script src="/assets/js/common.js"></script>
    {% block javascripts %}{% endblock %}
    <script>
        feather.replace();
        if (typeof draw === 'function') {
            draw(-10, 0, 1.2, 0.75);
        }
    </script>
</body>
</html>
