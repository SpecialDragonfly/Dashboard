APP_ENV=dev
APP_DEBUG=true
APP_SHARE_DIR=var/share

# SQLite by default (local dev). To switch to MySQL (production, or local
# MariaDB via docker-compose), set DB_CONNECTION=mysql plus the DB_* vars below.
# Real credentials should never be committed here — set them directly in the
# server's own .env (not checked in) or via docker-compose `environment:`.
# DB_CONNECTION=mysql
# DB_HOST=db
# DB_PORT=3306
# DB_NAME=notquitehuman
# DB_USER=notquitehuman
# DB_PASS=
